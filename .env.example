# =============================================================================
# SIEC Certificate Portal - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to GitHub - it contains real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Configuration (used for Authentication only)
# Get these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# -----------------------------------------------------------------------------
# Supabase Configuration (used for Database + File Storage - Free tier, no credit card)
# Get these from: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -----------------------------------------------------------------------------
# Role-Based Authorization
# Comma-separated list of pre-authorized admin email addresses
# These emails will be granted admin access automatically on sign-in
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourorg.edu,admin@example.com

# -----------------------------------------------------------------------------
# Admin Self-Registration Passcode (Security Key)
# Admins can self-register at /admin/login by entering this organization passcode
# Change this to a strong, unique value for your deployment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_REGISTRATION_KEY=change_me_to_a_strong_passcode
